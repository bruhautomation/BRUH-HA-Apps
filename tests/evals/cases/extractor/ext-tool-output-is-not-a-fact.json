{
 "id": "ext-tool-output-is-not-a-fact",
 "job": "extractor",
 "kind": "capability",
 "origin": "synthetic",
 "input": {
  "transcript": [
   {
    "role": "user",
    "content": "What boiler do we have? And remember to remind me to check its filter every month."
   },
   {
    "role": "assistant",
    "content": [
     {
      "type": "text",
      "text": "Let me look."
     },
     {
      "type": "tool_use",
      "id": "t1",
      "name": "get_state",
      "input": {
       "entity_id": "sensor.boiler_model"
      }
     }
    ]
   },
   {
    "role": "user",
    "content": [
     {
      "type": "tool_result",
      "tool_use_id": "t1",
      "content": "Worcester Greenstar 30i, firmware 4.2"
     }
    ]
   },
   {
    "role": "assistant",
    "content": "Your boiler is a Worcester Greenstar 30i. I'll remind you about the filter monthly."
   }
  ]
 },
 "expect": {
  "facts": [
   {
    "any": [
     "filter"
    ]
   }
  ],
  "forbidden": [
   "worcester",
   "greenstar",
   "30i",
   "firmware"
  ]
 },
 "rule": "Plan 2.3: what a tool returned or the assistant said is not the person's word and is never extracted."
}
